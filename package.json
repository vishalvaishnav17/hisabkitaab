{
  "name": "hisabkitaab",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply hisabkitaab-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply hisabkitaab-db --remote",
    "db:seed:local": "wrangler d1 execute hisabkitaab-db --local --file=seed.sql",
    "build": "bun build src/client/index.html --outdir dist --minify && cp -r public/. dist/",
    "typecheck": "tsc --noEmit && tsc -p src/client/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@types/bun": "latest",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "hono": "^4.13.16"
  }
}
