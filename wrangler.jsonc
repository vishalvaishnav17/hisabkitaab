{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hisabkitaab",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "expenses.vishalvaishnav.cc",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hisabkitaab-db",
      "database_id": "hisabkitaab-db-local"
    }
  ]
}
