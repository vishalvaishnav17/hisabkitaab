{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hisabkitaab",
	"main": "src/index.ts",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"build": {
		"command": "bun run build",
		"watch_dir": "src/client"
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "expenses.vishalvaishnav.cc",
			"custom_domain": true
		}
	],
	"services": [
		{
			"binding": "CLERK_GATE",
			"service": "clerk-gate"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hisabkitaab-db",
			"database_id": "d34e5eeb-d16d-40fa-a2b1-2de55196a94f"
		}
	]
}